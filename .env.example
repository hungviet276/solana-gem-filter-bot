APP_ENV=dev
LOG_LEVEL=INFO
AUTO_CREATE_SCHEMA=false
DATABASE_URL=postgresql+asyncpg://gem_filter:CHANGE_ME@postgres:5432/gem_filter

# Generate long independent random values. Never commit the real .env.
INTERNAL_API_TOKEN=CHANGE_ME_32_BYTES_OR_MORE
AUTH_SIGNING_SECRET=CHANGE_ME_32_BYTES_OR_MORE
BOOTSTRAP_ADMIN_EMAIL=admin@example.invalid
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_NOW

TELEGRAM_SOURCE_MODE=mock
TELEGRAM_SOURCE_IDS=0
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
TELEGRAM_SESSION_PATH=/run/secrets/telegram_reader.session
INGESTION_API_URL=http://api:8080/api/v1/ingestion/telegram

ALERT_BOT_TOKEN=
ALERT_DESTINATION_CHAT_IDS=
WATCH_ALERTS_ENABLED=false
ALERTS_KILL_SWITCH=false
ALERT_RATE_PER_MINUTE=20
PUBLIC_BASE_URL=http://localhost:8080

# Independent call-only alert flow. It does not wait for or evaluate whale messages.
EARLY_CANDIDATE_X2_ENABLED=false
EARLY_CANDIDATE_X2_DESTINATION_CHAT_IDS=

MARKET_PROVIDER_BASE_URL=https://api.dexscreener.com
MARKET_FALLBACK_BASE_URL=
MARKET_PROVIDER_TIMEOUT_SECONDS=5
MARKET_MAX_SNAPSHOT_AGE_SECONDS=20
ALLOWED_QUOTE_SYMBOLS=SOL,USDC,USDT

HELIUS_WEBHOOK_SECRET=
WEBHOOK_MAX_SKEW_SECONDS=300
ACTIVE_RULE_VERSION=GEM_FILTER_V2_FLOW_8

# Release images should be replaced with registry digests in production.
PYTHON_BASE_IMAGE=python:3.12.10-slim-bookworm
POSTGRES_IMAGE=postgres:17.2-alpine
PROMETHEUS_IMAGE=prom/prometheus:v3.1.0
GRAFANA_IMAGE=grafana/grafana:11.4.0
CADDY_IMAGE=caddy:2.9.1-alpine
PUBLIC_DOMAIN=
