{
  "title": "Solana Gem Filter - Operations",
  "uid": "solana-gem-filter",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"type": "timeseries", "title": "Ingestion lag P95", "gridPos": {"x": 0, "y": 0, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(telegram_ingestion_lag_seconds_bucket[5m])) by (le))"}]},
    {"type": "timeseries", "title": "Market provider latency P95", "gridPos": {"x": 8, "y": 0, "w": 8, "h": 8}, "targets": [{"expr": "histogram_quantile(0.95, sum(rate(market_provider_latency_seconds_bucket[5m])) by (le, provider))"}]},
    {"type": "stat", "title": "Orphans", "gridPos": {"x": 16, "y": 0, "w": 4, "h": 4}, "targets": [{"expr": "orphan_events_total"}]},
    {"type": "stat", "title": "Duplicates prevented", "gridPos": {"x": 20, "y": 0, "w": 4, "h": 4}, "targets": [{"expr": "sum(increase(duplicate_prevented_total[6h]))"}]},
    {"type": "timeseries", "title": "Score decisions", "gridPos": {"x": 0, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(score_evaluations_total[5m])) by (decision, rule_version)"}]},
    {"type": "timeseries", "title": "Alerts", "gridPos": {"x": 12, "y": 8, "w": 12, "h": 8}, "targets": [{"expr": "sum(rate(alerts_total[5m])) by (level, status)"}]}
  ]
}
